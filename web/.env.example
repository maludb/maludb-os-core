# The Business OS platform this front end reads from. Same box, no CORS: the server
# component forwards the visitor's CSTSID cookie straight to this origin.
API_BASE_URL=http://127.0.0.1:8080

# Where a signed-out visitor is sent to log in.
LOGIN_URL=http://localhost/login.php

# Same value as WEB_INTERNAL_KEY in config/.env — proves to PHP that a localhost call is this
# server, so the visitor address it forwards is believed (login lockout, activity log).
WEB_INTERNAL_KEY=
