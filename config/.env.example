# MaluDb OS — environment config.
# Copy to /var/www/config/.env and fill in. NEVER commit the real .env.
# bootstrap.php loads this file into the environment when APP_ENV is not 'prod'
# (in prod, set these as real environment variables via the systemd unit / Apache).

APP_ENV=dev
# APP_DEBUG=1 shows PHP errors in the browser — leave OFF (unset) on any reachable site.
APP_DEBUG=0
APP_NAME="MaluDb OS"
APP_URL=http://localhost:8080

# --- PostgreSQL (the app connects as the app_rw role; see db/000_extensions_roles.sql) ---
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=certstudy
DB_USER=app_rw
DB_PASSWORD=

# --- MaluMail (transactional email) ---
MALUMAIL_API_KEY=
MAIL_FROM=noreply@example.com
MAIL_FROM_NAME="MaluDb OS"

# --- Sign in with Google (server-side OIDC) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8080/auth/google/callback

# --- Secret keys (generate with: php -r "echo bin2hex(random_bytes(32));") ---
# Encrypts TOTP secrets at rest (libsodium). 64 hex chars = 32 bytes.
APP_TOTP_KEY=
# Signs short-lived action tokens for the actions MCP server (Phase 4).
ACTION_TOKEN_KEY=

# --- Public JSON API (/api/v1/…, docs/build-specs/public-api-org-graph.md) ---
# Comma-separated browser origins allowed to call the API directly (CORS). agentview's own
# server-to-server calls need none of this — an origin not listed here gets no CORS headers
# at all and is refused by the browser; empty (the default) allows no browser origin.
API_CORS_ORIGINS=
# Widens the session cookie to cover every host under this domain (e.g. ".subello.com" so
# one login covers both this app and agentview). Leave empty for localhost — bootstrap.php
# applies it only when the current request's host actually ends with this domain, so a value
# set for production can never silently break a localhost session.
SESSION_COOKIE_DOMAIN=

# The kernel's two faces (A2, 2026-09-22): super-admins run the operating system at OS_HOST;
# everyone signs in and launches applications at APP_HOST. Both empty = one face. The same two
# values go into the certstudy-web systemd drop-in (docs/deploy/certstudy-web.service.d-cutover.conf).
OS_HOST=os.example.com
APP_HOST=app.example.com
